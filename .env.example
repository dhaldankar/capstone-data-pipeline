# Copy this file to .env and fill in your own values.
# .env is git-ignored and should never be committed.
#
# The narrator uses the OpenAI-compatible API. Any provider that speaks the
# OpenAI Chat Completions format works by pointing LLM_BASE_URL at its endpoint
# (OpenAI, DeepSeek, etc.). When no API key is set, the pipeline falls back to a
# keyless, verified offline narrative.

# Provider label, used for logging/attribution only. Examples: openai, deepseek
LLM_PROVIDER=openai

# API key for the selected provider.
LLM_API_KEY=

# OpenAI-compatible base URL.
# Leave blank for OpenAI's default endpoint.
# For DeepSeek, set: https://api.deepseek.com
LLM_BASE_URL=

# Model name for the selected provider.
# OpenAI example:   gpt-4o-mini
# DeepSeek example: deepseek-chat
LLM_MODEL=gpt-4o-mini
